# Stateless tool API (PDF editor, converter, DockerHub search, country indices).
# No database or cache service is required by this backend.

# Private AI worker key used by the Nuxt frontend server. Use the same value as
# AI_API_KEY in ~/opt/ai-worker/ai-worker.env; never expose it to browser code.
AI_WORKER_KEY=
AI_WORKER_VACANCY_BATCH=10
AI_WORKER_MAX_PENDING=60
AI_WORKER_SUBMIT_CONCURRENCY=4
AI_WORKER_REQUEST_TIMEOUT_MS=3000
AI_WORKER_POLL_MS=5000
